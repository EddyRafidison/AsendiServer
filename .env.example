# OneXServer sample configuration. Copy to .env and replace all placeholders.
TZ=UTC
SERVER_PORT=3000
APP_VERSION=
PUBLIC_HTTPS_ORIGIN=https://example.com
FORCE_HTTPS=true
TRUST_PROXY_HOPS=1
SIGNUP_BODY_LIMIT=262144

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=onex
DB_USER=onex
DB_PSWD=
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=100
DB_LOCK_WAIT_TIMEOUT_SECONDS=30

# Account and financial policy
ADMIN_PSWD=
ADMIN_PIN=
FEES=3
P2P_ALLOWED=false
STOCK_LIMIT=18000000
INITIAL_BACKED_UNITS=18000000
SYSTEM_ADMIN_RESERVE_RATIO=0.10

# Shared BSC-USD and XTU limits: gross minimum and maximum per automatic credit tranche; no collection window. The weekly rule is one OneX system-funded purchase per user.
DEPOSIT_MIN_AMOUNT=20
DEPOSIT_MAX_AMOUNT=100
DEPOSIT_PENDING_EXPIRATION_DAYS=30
DISBURSEMENT_INDIVIDUAL_MINIMUM_XTU=200
DISBURSEMENT_INDIVIDUAL_MINIMUM_REMAINING_XTU=10
GLOBAL_DISBURSEMENT_BONUS=3
GLOBAL_DISBURSEMENT_REQUEST_WINDOW_DAYS=90
GLOBAL_DISBURSEMENT_EXTENSION_DAYS=30

# Welcome bonus: disabled until a positive amount is explicitly configured.
WELCOME_BONUS_BENEFICIARIES=1000
WELCOME_BONUS_AMOUNT_XTU=0
WELCOME_BONUS_CLAIM_SECRET=

# BNB Smart Chain Mainnet
# Outgoing operations: configure your real Chainstack BSC Mainnet HTTPS endpoint.
# EXAMPLE ONLY: this placeholder is deliberately fictitious and will not connect.
BSC_RPC_URL=https://nd-000-000-000.p2pify.com/REPLACE_WITH_CHAINSTACK_NODE_TOKEN

# Incoming deposits: PublicNode is the primary public HTTP + WebSocket source.
BSC_INCOMING_RPC_URL=https://bsc-rpc.publicnode.com
BSC_INCOMING_WS_RPC_URL=wss://bsc-rpc.publicnode.com

# Incoming HTTP fallback: use the Chainstack endpoint only when PublicNode is
# unavailable/rate-limited. This fictitious value should match BSC_RPC_URL.
BSC_INCOMING_RPC_FALLBACK_URL=https://nd-000-000-000.p2pify.com/REPLACE_WITH_CHAINSTACK_NODE_TOKEN
BSC_INCOMING_RPC_COOLDOWN_MS=30000

# Outgoing transaction routing deliberately stays on Chainstack in this release.
# Do not add an automatic outgoing RPC fallback until signed-transaction recovery
# can safely reconcile uncertain broadcasts and nonce state.

# Legacy aliases retained for older deployments. Prefer the explicit variables above.
# BSC_RPC_FALLBACK_URL is an incoming-scanner fallback only; it is not an outgoing fallback.
BSC_RPC_FALLBACK_URL=
BSC_WS_RPC_URL=
BSC_BNB_USD_FEED_ADDRESS=0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE
BSC_MAX_TX_FEE_BSC_USD=0.4
USDT_BEP20_CONTRACT=
USDT_BEP20_TREASURY_ADDRESS=
USDT_BEP20_COLD_WALLET_ADDRESS=
USDT_BEP20_DISBURSEMENT_ADDRESS=
USDT_BEP20_RECEIVER_ADDRESS=
USDT_TREASURY_MIN_OPERATING_BSC_USD=0  # Set a deliberate production operating floor
USDT_COLD_SWEEP_THRESHOLD_BSC_USD=500
USDT_COLD_SWEEP_PERCENT=90
USDT_COLD_SWEEP_POLL_MS=30000
USDT_TREASURY_ENV_FILE=.env.treasury
USDT_DISBURSEMENT_ENV_FILE=.env.disbursement
USDT_INCOMING_START_BLOCK=
USDT_MAX_LOG_BLOCK_RANGE=1500
USDT_MIN_CONFIRMATIONS=15
USDT_DISBURSEMENTS_ENABLED=false
USDT_INDIVIDUAL_DISBURSEMENT_ENABLED=false
USDT_GLOBAL_DISBURSEMENT_ENABLED=false
USDT_SELLER_PAYOUTS_ENABLED=false
USDT_PAYMENTS_ENABLED=true
USDT_DISBURSEMENT_CONFIRMATIONS=15
USDT_DISBURSEMENT_GAS_LIMIT=100000
USDT_DISBURSEMENT_POLL_MS=15000
USDT_PAYMENT_POLL_MS=30000
USDT_CURSOR_HASH_CHECK_INTERVAL_MS=60000
USDT_WS_MIN_SCAN_INTERVAL_MS=10000
USDT_DEPOSIT_QUEUE_POLL_MS=30000

# Authentication and resource limits
DEVICE_SESSION_TTL_DAYS=30
ARGON2_MAX_PARALLEL=2
ARGON2_MAX_QUEUE=20
ARGON2_QUEUE_TIMEOUT_MS=5000
HTTP_RATE_LIMIT_GLOBAL=300
HTTP_RATE_WINDOW_MS=60000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TTL_MINUTES=10
TELEGRAM_OUTBOX_RETRY_LIMIT=12
TELEGRAM_POLL_TIMEOUT=25

# Email and SMTP
SERV_MAIL=
SERV_MAIL_PSWD=
MAIL_PORT=587
SMTP_HOST=
MAIL_OUTBOX_CONCURRENCY=3
MAIL_OUTBOX_MAX_ATTEMPTS=12
MAIL_OUTBOX_MAX_PENDING=10000
MAIL_OUTBOX_MAX_PER_HOUR=1000

# Background workers
SELLER_LIFECYCLE_POLL_MS=30000

# Automatic refund worker (keep disabled until full MySQL/EVM validation)
AUTOMATIC_REFUNDS_ENABLED=false
AUTOMATIC_REFUNDS_POLL_MS=15000
AUTOMATIC_REFUNDS_CONFIRMATIONS=15
AUTOMATIC_REFUNDS_GAS_LIMIT=250000
