# Database
DB_HOST=127.0.0.1
DB_USER=onex_user
DB_PSWD=replace_with_database_password
DB_NAME=onexdb
DB_PORT=3306
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=100
DB_LOCK_WAIT_TIMEOUT_SECONDS=30

# HTTP server
SERVER_PORT=3000
APP_VERSION=1.0.0
HTTP_RATE_LIMIT_GLOBAL=180
HTTP_RATE_WINDOW_MS=60000
# Number of trusted reverse-proxy hops. Keep 0 when Node receives direct client traffic.
TRUST_PROXY_HOPS=0
FORCE_HTTPS=false
# Required only when FORCE_HTTPS=true. Use the canonical public HTTPS origin.
PUBLIC_HTTPS_ORIGIN=https://api.example.com
# Normal endpoints are limited to 256kb; signup uses this dedicated limit for identity images.
SIGNUP_BODY_LIMIT=10mb
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

# Mail / Nodemailer
SERV_MAIL=replace_with_sender_email
SERV_MAIL_PSWD=replace_with_mail_app_password
MAIL_OUTBOX_MAX_PER_HOUR=30
MAIL_OUTBOX_MAX_PENDING=50
MAIL_OUTBOX_CONCURRENCY=2
MAIL_OUTBOX_MAX_ATTEMPTS=2
SMTP_HOST=smtp.gmail.com
MAIL_PORT=587
ONEX_SUPPORT_EMAIL=support@example.com
ONEX_SUPPORT_PHONE=replace_with_support_phone

# Admin credentials: provide values encrypted in the format expected by utils.js.
ADMIN_PSWD=replace_with_encrypted_admin_password
ADMIN_PIN=replace_with_encrypted_admin_pin

# Business settings
FEES=3
STOCK_LIMIT=18000000
# Initial common.backed_units in initial-asset units. The default is STOCK_LIMIT (18,000,000).
INITIAL_BACKED_UNITS=18000000
P2P_ALLOWED=false
ARGON2_MAX_PARALLEL=4
ARGON2_MAX_QUEUE=20
ARGON2_QUEUE_TIMEOUT_MS=15000

# BNB Smart Chain mainnet: Binance-Peg BSC-USD (not Tether-issued USDt).
USDT_PAYMENTS_ENABLED=false
BSC_RPC_URL=https://replace-with-primary-bsc-rpc-provider
BSC_RPC_FALLBACK_URL=https://replace-with-secondary-bsc-rpc-provider
# Optional WebSocket endpoint for faster new-block wake-ups. The HTTP log scanner remains authoritative.
BSC_WS_RPC_URL=
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955
USDT_BEP20_TREASURY_ADDRESS=replace_with_40_hex_character_treasury_address
USDT_MIN_CONFIRMATIONS=15
USDT_PAYMENT_POLL_MS=5000
USDT_MAX_LOG_BLOCK_RANGE=250
# Optional first scan block. Leave blank to start at the current finalized block on first startup.
# Set explicitly before accepting deposits if earlier treasury history must be indexed.
USDT_INCOMING_START_BLOCK=

# Optional Telegram notifications. Users may use OneX without linking Telegram.
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_BOT_USERNAME=replace_with_bot_username_without_at
TELEGRAM_LINK_TTL_MINUTES=10
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_OUTBOX_RETRY_LIMIT=10

# Run the treasury payment/refund worker separately.
# Master gate plus independent admission gates for user-requested and global liquidation modes.
USDT_DISBURSEMENTS_ENABLED=false
USDT_INDIVIDUAL_DISBURSEMENT_ENABLED=false
USDT_GLOBAL_DISBURSEMENT_ENABLED=false
USDT_DISBURSEMENT_ENV_FILE=.env.disbursement
USDT_DISBURSEMENT_POLL_MS=3000
USDT_DISBURSEMENT_CONFIRMATIONS=15
USDT_DISBURSEMENT_GAS_LIMIT=100000
DISBURSEMENT_INDIVIDUAL_MINIMUM_XTU=200
DISBURSEMENT_INDIVIDUAL_MINIMUM_REMAINING_XTU=0

# Financial policy
# A one-time welcome credit is only considered on the user's first successful sign-in.
# The first N registered accounts are eligible; 0 disables the beneficiary group.
WELCOME_BONUS_BENEFICIARIES=1000
# Set a positive amount to enable the credit. The safe default 0 disables all credits.
WELCOME_BONUS_AMOUNT_XTU=0
# Stable HMAC secret used to prevent a second lifetime credit after account deletion and re-registration.
# Keep this secret unchanged. When omitted, the database password is used as the fallback key.
WELCOME_BONUS_CLAIM_SECRET=
# Initial administrative reserve ratio; the remaining 90% is initially distributable.
SYSTEM_ADMIN_RESERVE_RATIO=0.10
# Defaults to FEES when omitted; the effective global bonus may not exceed 10%.
GLOBAL_DISBURSEMENT_BONUS=
GLOBAL_DISBURSEMENT_REQUEST_WINDOW_DAYS=90
GLOBAL_DISBURSEMENT_EXTENSION_DAYS=30

# Chainlink BNB/USD Data Feed on BNB Smart Chain Mainnet (chain ID 56).
# The server reads latestRoundData() directly through BSC_RPC_URL; no API key or manual quote is needed.
BSC_BNB_USD_FEED_ADDRESS=0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE
# Poll the on-chain feed every 60 seconds and reject answers older than 300 seconds.
BSC_PRICE_REFRESH_INTERVAL_MS=60000
BSC_PRICE_MAX_AGE_SECONDS=300
# Maximum estimated BSC network cost for treasury payouts, refunds and disbursements.
# Hard maximum: 0.4 BSC-USD. Values above it are rejected when the HTTP server starts.
BSC_MAX_TX_FEE_BSC_USD=0.4

# Indexed global-price event processing for individual remuneration thresholds.
PRICE_EVENT_POLL_MS=3000
PRICE_EVENT_BATCH_SIZE=500

# Optional priority-seller treasury payouts
USDT_SELLER_PAYOUTS_ENABLED=false
SELLER_LIFECYCLE_POLL_MS=60000
