# XTU distribution-wallet configuration. Copy to .env.xtu and replace every dummy value.
# Keep this file separate from .env.treasury and .env.disbursement.
# Never reuse the BSC-USD treasury/disbursement private keys.

XTU_WITHDRAWAL_WORKER_ENABLED=false
XTU_CHAIN_ID=56
XTU_TOKEN_CONTRACT_ADDRESS=0x2222222222222222222222222222222222222222
XTU_DISTRIBUTION_ADDRESS=0x1111111111111111111111111111111111111111
XTU_DISTRIBUTION_PRIVATE_KEY=0x1111111111111111111111111111111111111111111111111111111111111111
XTU_MIN_CONFIRMATIONS=15
XTU_WITHDRAWAL_POLL_MS=15000
XTU_WITHDRAWAL_GAS_LIMIT=250000
XTU_WITHDRAWAL_RETRY_MS=60000
XTU_MAX_PENDING_PER_USER=1
