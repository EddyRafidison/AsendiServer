# Public BNB Smart Chain XTU configuration. All addresses below are examples only.
# Keep private keys in separate, permission-restricted files.

XTU_CHAIN_ID=56
XTU_TOKEN_CONTRACT_ADDRESS=0x2222222222222222222222222222222222222222
XTU_MAIN_WALLET_ADDRESS=0x3333333333333333333333333333333333333333
XTU_DISTRIBUTION_ADDRESS=0x1111111111111111111111111111111111111111

# Separate activation controls; both are disabled by default.
XTU_WITHDRAWAL_WORKER_ENABLED=false
XTU_DEPOSIT_WORKER_ENABLED=false
XTU_MIN_CONFIRMATIONS=15
XTU_WITHDRAWAL_POLL_MS=15000
XTU_WITHDRAWAL_GAS_LIMIT=250000
XTU_WITHDRAWAL_RETRY_MS=60000
XTU_MAX_PENDING_PER_USER=1

# XTU deposit scanner and consolidation
XTU_INCOMING_RPC_URL=
XTU_INCOMING_START_BLOCK=
XTU_DEPOSIT_POLL_MS=15000
XTU_DEPOSIT_MAX_LOG_BLOCK_RANGE=1000
# DEPOSIT_MIN_AMOUNT and DEPOSIT_MAX_AMOUNT are shared settings in the main .env (20-100 gross per 60-minute session). Weekly cooldown: one OneX system-funded purchase per user.
# First automatic XTU credit tranche only; separate from shared 20-100 intake limits.
XTU_DEPOSIT_MAX_INITIAL_CREDIT_XTU=100
# Minimum actual XTU received by the Hot Wallet before one internal consolidation.
XTU_DEPOSIT_CONSOLIDATION_MIN_BATCH_XTU=100
XTU_DEPOSIT_BATCH_WINDOW_MS=3600000
XTU_DEPOSIT_INITIAL_GROUPING_TIMEOUT_DAYS=30
XTU_DEPOSIT_PENDING_RETRY_DAYS=7
XTU_DEPOSIT_GAS_LIMIT=250000
