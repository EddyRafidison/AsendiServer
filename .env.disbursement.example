# Loaded only by disbursement-worker.js; do not copy this key into the HTTP .env.
# This key must control exactly USDT_BEP20_TREASURY_ADDRESS from the main .env.
# The isolated treasury worker processes individual disbursements, global liquidation
# batches, seller payouts and refunds. Accepted jobs continue even after admission flags
# are disabled; keep this worker running until all accepted jobs are reconciled.
BSC_DISBURSEMENT_PRIVATE_KEY=replace_with_treasury_private_key
