# Database
DB_HOST=127.0.0.1
DB_USER=onex_user
DB_PSWD=replace_with_database_password
DB_NAME=onexdb
DB_PORT=3306
DB_CONNECTION_LIMIT=50

# HTTP server
SERVER_PORT=3000
APP_VERSION=1.0.0

# Mail / Nodemailer
SERV_MAIL=replace_with_sender_email
SERV_MAIL_PSWD=replace_with_mail_app_password
SMTP_HOST=smtp.gmail.com
MAIL_PORT=587
ONEX_SUPPORT_EMAIL=support@example.com
ONEX_SUPPORT_PHONE=replace_with_support_phone

# Admin credentials: provide values encrypted in the format expected by utils.js.
ADMIN_PSWD=replace_with_encrypted_admin_password
ADMIN_PIN=replace_with_encrypted_admin_pin

# Business settings
FEES=3
STOCK_LIMIT=10000000
# Initial common.backed_units in initial-asset units; set only the reserve actually available.
INITIAL_BACKED_UNITS=0
P2P_ALLOWED=false
FIRST_WELCOME_CLIENTS=-1
WELCOME_BONUS=0
ARGON2_MAX_PARALLEL=4
ARGON2_MAX_QUEUE=100

# BNB Smart Chain mainnet: Binance-Peg BSC-USD (not Tether-issued USDt).
USDT_PAYMENTS_ENABLED=false
BSC_RPC_URL=https://replace-with-primary-bsc-rpc-provider
BSC_RPC_FALLBACK_URL=https://replace-with-secondary-bsc-rpc-provider
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955
USDT_BEP20_TREASURY_ADDRESS=replace_with_40_hex_character_treasury_address
BSC_DEPOSIT_XPUB=replace_with_public_extended_key
USDT_MIN_CONFIRMATIONS=15
USDT_PAYMENT_POLL_MS=5000
USDT_MAX_LOG_BLOCK_RANGE=250
USDT_MAX_WALLETS_PER_POLL=25

# Run this worker separately; do not enable the sweeper in the HTTP process.
USDT_SWEEP_ENABLED=false
USDT_SWEEP_IN_MAIN_PROCESS=false
USDT_SWEEP_ENV_FILE=.env.sweeper
USDT_SWEEP_INTERVAL_MS=60000
USDT_SWEEP_BATCH_SIZE=10
USDT_SWEEP_TOKEN_GAS_LIMIT=100000

# Run the treasury payment/refund worker separately.
USDT_DISBURSEMENTS_ENABLED=false
USDT_DISBURSEMENT_ENV_FILE=.env.disbursement
USDT_DISBURSEMENT_POLL_MS=3000
USDT_DISBURSEMENT_CONFIRMATIONS=15
USDT_DISBURSEMENT_GAS_LIMIT=100000
