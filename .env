# Database
DB_HOST=127.0.0.1
DB_USER=onex_user
DB_PSWD=replace_with_database_password
DB_NAME=onexdb
DB_PORT=3306

# Server
SERVER_PORT=5555
APP_VERSION=1.2.3

# Mail
SERV_MAIL=replace_with_sender_email
SERV_MAIL_PSWD=replace_with_mail_app_password
SMTP_HOST=smtp.gmail.com
MAIL_PORT=587
ONEX_SUPPORT_EMAIL=support@example.com
ONEX_SUPPORT_PHONE=replace_with_support_phone

# Admin credentials are kept in their existing encrypted format during this migration.
ADMIN_PSWD=replace_with_existing_encrypted_admin_password
ADMIN_PIN=replace_with_existing_encrypted_admin_pin

# Fees and limits
FEES=3
# Maximum allowed user balance, denominated in One-Val units.
STOCK_LIMIT=10000000
P2P_ALLOWED=false
# Welcome bonus is stored directly in One-Val units.
WELCOME_BONUS=300
FIRST_WELCOME_CLIENTS=-1

# Limits simultaneous Argon2 operations to control CPU and memory usage.
ARGON2_MAX_PARALLEL=4
ARGON2_MAX_QUEUE=100

# BEP-20 recharge on BNB Smart Chain mainnet.
USDT_PAYMENTS_ENABLED=false
# Use paid RPC endpoints that explicitly support eth_getLogs and historical receipts.
BSC_RPC_URL=https://replace-with-primary-bsc-rpc-provider
BSC_RPC_FALLBACK_URL=https://replace-with-secondary-bsc-rpc-provider
# Approved token: Binance-Peg BSC-USD (not USDt directly issued by Tether).
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955
USDT_BEP20_EXPECTED_DECIMALS=18
# Main OneX treasury address. Deposit addresses are derived separately per user.
USDT_BEP20_TREASURY_ADDRESS=0xreplace_with_onex_treasury_address
# Public extended key of the BIP-32 branch used for user deposit addresses.
# Derive this offline from m/44'/60'/0'/0 and keep the corresponding xprv offline unless sweeping is enabled.
BSC_DEPOSIT_XPUB=xpub_replace_with_public_extended_key
# Confirmation depth and scanner sizing.
USDT_MIN_CONFIRMATIONS=15
USDT_PAYMENT_POLL_MS=5000
USDT_MAX_LOG_BLOCK_RANGE=250
USDT_MAX_WALLETS_PER_POLL=25

# Automatic per-user address consolidation.
# Keep false until the xprv and the separate BNB gas-funding wallet are securely provisioned.
# The HTTP process must keep this disabled. Run `npm run sweep` as a separate
# service with secrets loaded from .env.sweeper instead.
USDT_SWEEP_ENABLED=false
USDT_SWEEP_IN_MAIN_PROCESS=false
# Do not put BSC_DEPOSIT_XPRV or BSC_SWEEP_FUNDER_PRIVATE_KEY in this file.
USDT_SWEEP_ENV_FILE=.env.sweeper
USDT_SWEEP_INTERVAL_MS=60000
USDT_SWEEP_BATCH_SIZE=10
USDT_SWEEP_TOKEN_GAS_LIMIT=100000
# Fixed business rules in recharge-policy.js:
# minimum 70 BSC-USD, maximum 140 BSC-USD, one successful credit per 7 days,
# maximum balance 300 One-Val, payment request lifetime 60 minutes,
# consolidate each user's deposit address at 70 BSC-USD or after 30 days.

# User-to-system BSC-USD disbursements (run in a dedicated process).
USDT_DISBURSEMENTS_ENABLED=false
USDT_DISBURSEMENT_ENV_FILE=.env.disbursement
USDT_DISBURSEMENT_POLL_MS=3000
USDT_DISBURSEMENT_CONFIRMATIONS=15
USDT_DISBURSEMENT_GAS_LIMIT=100000
